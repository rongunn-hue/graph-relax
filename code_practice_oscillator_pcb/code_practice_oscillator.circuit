# Code practice oscillator: oscillator is continuously powered; key gates only the audio output.
# Approximate oscillator frequency: 669 Hz with R5=68k and C1=10nF.
# J3 is the connection for a passive high-impedance piezo transducer.
circuit "Code Practice Oscillator — Continuous 670 Hz Oscillator with Keyed Output"

component J1 GENERIC_CONNECTOR_2
component J2 GENERIC_CONNECTOR_2
component J3 GENERIC_CONNECTOR_2
component U1 LM1458
component Q1 P2N2222A
component R1 GENERIC_RESISTOR
component R2 GENERIC_RESISTOR
component R3 GENERIC_RESISTOR
component R4 GENERIC_RESISTOR
component R5 GENERIC_RESISTOR
component R6 GENERIC_RESISTOR
component R7 GENERIC_RESISTOR
component C1 GENERIC_CAPACITOR
component C2 GENERIC_CAPACITOR
component C3 GENERIC_CAPACITOR
component C4 GENERIC_CAPACITOR
component C5 GENERIC_CAPACITOR

net "+9V" J1.1 U1.8 R1.1 R7.1 C3.1 C4.1
net "GND" J1.2 U1.4 R2.2 Q1.3 J2.2 J3.2 C3.2 C4.2 C5.2
net "VREF_DIV" R1.2 R2.1 U1.5 C5.1
net "VREF" U1.6 U1.7 R4.2 C1.2
net "OSC_PLUS" U1.3 R3.2 R4.1
net "OSC_MINUS" U1.2 R5.2 C1.1
net "OSC_OUT" U1.1 R3.1 R5.1 C2.1
net "AUDIO_FEED" C2.2 R6.1
net "AUDIO_OUT" R6.2 Q1.1 J3.1
net "KEY_CTRL" R7.2 Q1.2 J2.1

source_metadata '{"normalized":{"schema":"manual-circuit-design-1","title":"Code Practice Oscillator — Continuous 670 Hz Oscillator with Keyed Output","rails":["+9V","GND"],"groups":[],"blocks":[{"name":"POWER_AND_REFERENCE","members":["J1","R1","R2","C3","C4","C5","U1.B"]},{"name":"OSCILLATOR","members":["U1.A","R3","R4","R5","C1"]},{"name":"KEY_GATE_AND_OUTPUT","members":["J2","J3","Q1","R6","R7","C2"]}],"parts":[{"ref":"J1","value":"9V POWER"},{"ref":"J2","value":"MORSE KEY"},{"ref":"J3","value":"PASSIVE PIEZO"},{"ref":"U1","value":"LM1458"},{"ref":"Q1","value":"P2N2222A"},{"ref":"R1","value":"10k"},{"ref":"R2","value":"10k"},{"ref":"R3","value":"100k"},{"ref":"R4","value":"100k"},{"ref":"R5","value":"68k"},{"ref":"R6","value":"1k"},{"ref":"R7","value":"10k"},{"ref":"C1","value":"10nF"},{"ref":"C2","value":"1uF"},{"ref":"C3","value":"100nF"},{"ref":"C4","value":"10uF"},{"ref":"C5","value":"10uF"}]}}'
